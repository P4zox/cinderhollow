# build caches and outputs (web/dist/index.html is kept: it's the playable game)
web/.pngcache/
web/dist/*
!web/dist/index.html
__pycache__/
*.pyc
.DS_Store

# headless test harness: keep the harness + reusable tests, not screenshots or node_modules
tools/shots/node_modules/
tools/shots/out/
tools/shots/*.png
tools/shots/dbg*.js
tools/shots/*_dbg.js
tools/shots/adj_test.js

# review contact sheets (regenerable from the art generators)
art/previews/

# user-supplied reference art (not ours to redistribute)
art/concepts/ref_*
