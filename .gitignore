# build caches and outputs (web/dist/index.html is kept: it's the playable game)
web/.pngcache/
web/dist/*
!web/dist/index.html
!web/dist/pub/
__pycache__/
*.pyc
.DS_Store

# headless test harness: keep the harness + reusable tests, not screenshots or node_modules
tools/shots/node_modules/
tools/shots/out/
tools/shots/*.png
tools/shots/dbg*.js
tools/shots/*_dbg.js
tools/shots/adj_test.js

# review contact sheets (regenerable from the art generators)
art/previews/

# user-supplied reference art (not ours to redistribute)
art/concepts/ref_*
tools/.reach_cache.json
tools/shots/*/out/
tools/shots/*/*/
tools/shots/**/*.png
tools/shots/**/*.log

# bg v2 pilot (docs/v17/bg_pilot.md): raw ComfyUI renders are ~8 MB per pair of biomes; the gen_bg_<biome>_v2.py build
# needs <layer>_render.png locally (or --render to regenerate them with ComfyUI). Guides, outputs and stats stay tracked.
art/bg_src/*/*_pass1.png
art/bg_src/*/*_render.png
art/bg_src/*/v1/
art/bg_src/*/sweep/

# prop rework batch B (docs/v17/props_b.md): renders, guides and previews; rebuilt by art/gen_props_b_*.py (--render for ComfyUI)
art/bg_src/props_b/

# prop rework batch A (docs/v17/props_a.md): ComfyUI renders, IP-Adapter refs, v1 sheet backups; rebuilt by art/gen_props_a.py (--render for ComfyUI)
art/bg_src/props_a/
